# Copy to .env and fill in. Passwords: letters and numbers only.
POSTGRES_USER=nlsql_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nlsql
DB_HOST=localhost
DB_PORT=5433
APP_DB_USER=nlsql_reader
APP_DB_PASSWORD=change_me
ANTHROPIC_API_KEY=your_key_here
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Optional: run on Amazon Bedrock instead (uses the keys from `aws configure`)
LLM_PROVIDER=anthropic
AWS_REGION=us-east-1
BEDROCK_MODEL=global.anthropic.claude-opus-4-6-v1
